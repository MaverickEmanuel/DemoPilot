{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "demopilot",
  "description": "Turn a prompt into a polished product-demo MP4. Bundles the demopilot-demo-scripts authoring skill together with the DemoPilot MCP server (Playwright browser capture + a Remotion spring-camera compositor).",
  "version": "0.1.0",
  "author": {
    "name": "DemoPilot contributors",
    "url": "https://github.com/MaverickEmanuel/DemoPilot"
  },
  "homepage": "https://github.com/MaverickEmanuel/DemoPilot#readme",
  "repository": "https://github.com/MaverickEmanuel/DemoPilot",
  "license": "MIT",
  "keywords": ["mcp", "demo", "video", "screen-recording", "playwright", "remotion"],
  "skills": "./.claude/skills",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/.claude/hooks/sync-skill-docs.sh"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "demopilot": {
      "command": "npx",
      "args": ["-y", "demopilot-mcp"]
    }
  }
}
